{
  "version": 1,
  "build": {
    "checks": [
      {
        "id": "build.sim2gse-product",
        "command": ".venv\\Scripts\\python.exe scripts/dev/sim2gse/build.py",
        "timeoutSeconds": 1200
      },
      {
        "id": "build.assets",
        "command": ".venv\\Scripts\\python.exe scripts/media/build_assets.py --output-root .local/build/assets"
      }
    ]
  },
