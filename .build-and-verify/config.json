          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json"
        ]
      },
      {
        "id": "verify.toc",
        "command": ".venv\\Scripts\\python.exe scripts/dev/check.py toc",
        "checkParallel": true,
        "paths": [
          "addons/EUI_FacetedPortrait/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".luarc.json",
          ".luacheckrc",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json"
        ],
        "inputs": [
          "addons/EUI_FacetedPortrait/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".luarc.json",
          ".luacheckrc",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json"
