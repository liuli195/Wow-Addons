          ".build-and-verify/config.json",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json",
          "scripts/media/**"
        ]
      },
      {
        "id": "verify.docs",
        "command": ".venv\\Scripts\\python.exe scripts/dev/check.py docs",
        "checkParallel": true,
        "paths": [
          "README.md",
          "AGENTS.md",
          "docs/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json",
          "myspec/changes/**",
          "projects/sim2gse/README.md",
          "tests/**/*.md",
          "projects/*/README.md"
        ],
        "inputs": [
          "README.md",
          "AGENTS.md",
          "docs/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json",
          "myspec/changes/**",
          "projects/sim2gse/README.md",
          "tests/**/*.md",
          "projects/*/README.md"
        ]
      },
      {
        "id": "verify.checker-tests",
        "command": ".venv\\Scripts\\python.exe tests/dev/test_checks.py",
        "checkParallel": true,
        "paths": [
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".luarc.json",
          ".luacheckrc",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json",
          "tests/dev/**"
