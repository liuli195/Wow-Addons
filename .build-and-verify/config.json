          "AGENTS.md",
          "docs/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json",
          "myspec/changes/**",
          "projects/sim2gse/README.md",
          "tests/**/*.md",
          "projects/*/README.md"
        ],
        "inputs": [
          "README.md",
          "AGENTS.md",
          "docs/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".github/workflows/verify.yml",
