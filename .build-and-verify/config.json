        "command": ".venv\\Scripts\\python.exe scripts/dev/check.py luals --source addons/Sim2GSEProbe",
        "checkParallel": true,
        "paths": [
          "addons/Sim2GSEProbe/**",
          "scripts/dev/check.py",
          "scripts/dev/versions.json",
          ".build-and-verify/config.json",
          ".luarc.json"
        ],
        "inputs": [
          "addons/Sim2GSEProbe/**",
          "scripts/dev/check.py",
          "scripts/dev/versions.json",
          ".build-and-verify/config.json",
          ".luarc.json"
        ]
      },
      {
        "id": "verify.sim2gse-probe-luacheck",
        "command": ".venv\\Scripts\\python.exe scripts/dev/check.py luacheck --source addons/Sim2GSEProbe",
        "checkParallel": true,
        "paths": [
          "addons/Sim2GSEProbe/**",
          "scripts/dev/check.py",
          ".build-and-verify/config.json",
          ".luacheckrc"
        ],
        "inputs": [
          "addons/Sim2GSEProbe/**",
          "scripts/dev/check.py",
          ".build-and-verify/config.json",
          ".luacheckrc"
        ]
      },
      {
        "id": "verify.sim2gse-probe-toc",
        "command": ".venv\\Scripts\\python.exe scripts/dev/check.py toc --source addons/Sim2GSEProbe",
        "checkParallel": true,
        "paths": [
          "addons/Sim2GSEProbe/**",
          "scripts/dev/check.py",
          "scripts/dev/versions.json",
          ".build-and-verify/config.json"
        ],
        "inputs": [
          "addons/Sim2GSEProbe/**",
          "scripts/dev/check.py",
          "scripts/dev/versions.json",
          ".build-and-verify/config.json"
        ]
      },
      {
        "id": "verify.assets",
        "command": ".venv\\Scripts\\python.exe scripts/media/verify.py",
        "checkParallel": true,
        "paths": [
          "scripts/media/verify.py",
          "addons/EUI_FacetedPortrait/**",
          "assets/EUI_FacetedMedia/SharedMedia_MyMedia/statusbar/EUI Faceted Bar.tga",
          "assets/EUI_FacetedMedia/SharedMedia_MyMedia/border/EUI Faceted Border.tga",
