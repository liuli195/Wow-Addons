{
  "version": 1,
  "build": {
    "checks": [
      {
        "id": "build.sim2gse-product",
        "command": ".venv\\Scripts\\python.exe scripts/dev/sim2gse/build.py",
        "timeoutSeconds": 1200
      },
      {
        "id": "build.assets",
        "command": ".venv\\Scripts\\python.exe scripts/media/build_assets.py --output-root .local/build/assets"
      }
    ]
  },
  "verify": {
    "maxParallel": 2,
    "fullBudgetSeconds": 60,
    "checks": [
      {
        "id": "verify.luals",
        "command": ".venv\\Scripts\\python.exe scripts/dev/check.py luals",
        "checkParallel": true,
        "paths": [
          "addons/EUI_FacetedPortrait/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".luarc.json",
          ".luacheckrc",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json"
        ],
        "inputs": [
          "addons/EUI_FacetedPortrait/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".luarc.json",
          ".luacheckrc",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json"
        ]
      },
      {
        "id": "verify.luacheck",
        "command": ".venv\\Scripts\\python.exe scripts/dev/check.py luacheck",
        "checkParallel": true,
        "paths": [
          "addons/EUI_FacetedPortrait/**",
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".luarc.json",
          ".luacheckrc",
          ".github/workflows/verify.yml",
          ".pr-flow/toolchain.json"
