          "tests/**/*.md",
          "projects/*/README.md"
        ]
      },
      {
        "id": "verify.checker-tests",
        "command": ".venv\\Scripts\\python.exe tests/dev/test_checks.py",
        "paths": [
          "scripts/dev/**",
          ".build-and-verify/config.json",
          ".luarc.json",
          ".luacheckrc",
          ".github/workflows/verify.yml",
