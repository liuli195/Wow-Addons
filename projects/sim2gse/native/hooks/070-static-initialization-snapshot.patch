+// Specialization parameters stay in the native specialization binding.
+void death_knight_t::precombat_init()
+{
+  player_t::precombat_init();
+  if ( specialization() != DEATH_KNIGHT_UNHOLY || !sim2gse_static_snapshot_json.empty() ) return;
+  std::map<std::string, double> parameters = {
+    { "rune_recharge_ms", 1000.0 / runes_per_second() },
+    { "rune_recharge_slots", static_cast<double>( MAX_REGENERATING_RUNES ) },
+    { "lesser_ghoul_ready_stacks", static_cast<double>( buffs.lesser_ghoul_ready->check() ) }
+  };
+  if ( background_actions.dread_plague )
+    parameters[ "dread_plague_duration_ms" ] =
+      background_actions.dread_plague->composite_dot_duration( nullptr ).total_millis();
+  sim2gse::capture_static_snapshot( *this,
+    { "outbreak", "putrefy", "death_and_decay", "death_coil", "epidemic",
+      "festering_strike", "festering_scythe", "scourge_strike" }, parameters,
+    { { "cycle_of_death", talent.unholy.cycle_of_death.ok() },
+      { "festering_scythe", talent.unholy.festering_scythe.ok() } } );
+}
