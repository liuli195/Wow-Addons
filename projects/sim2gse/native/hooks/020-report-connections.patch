+      row[ "selected_talent" ] = selected_talent;
+      row[ "background" ] = action->background;
+      row[ "passive" ] = action->data().flags( SX_PASSIVE );
+      row[ "quiet" ] = action->quiet;
+      row[ "action_initialized" ] = action->initialized;
