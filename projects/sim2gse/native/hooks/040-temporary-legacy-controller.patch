+static timespan_t sim2gse_action_delay(player_t* p, action_t* a, bool client_clock)
+{
+  if (a->gcd() == 0_ms) return 0_ms;
+  const auto ready = client_clock ? p->sim2gse_client_gcd_ready : p->gcd_ready;
+  auto delay = std::max(0_ms, ready - p->sim->current_time());
+  delay = std::max(delay, a->cooldown->remains());
+  if (!a->usable_during_current_cast())
+    delay = std::max(delay, p->sim2gse_precombat_cast_ready - p->sim->current_time());
+  if (p->executing && p->executing->execute_event)
+    delay = std::max(delay, p->executing->execute_event->remains());
+  else if (p->channeling && p->channeling->get_dot())
+    delay = std::max(delay, p->channeling->get_dot()->remains());
+  return delay;
+}
+
+static bool sim2gse_queue_requirements(action_t* a)
+{
+  a->sim2gse_ignore_cooldown_ready = true;
+  const bool ready = a->action_ready();
+  a->sim2gse_ignore_cooldown_ready = false;
+  return ready;
+}
+
+static void sim2gse_finish_committed(player_t* p)
+{
+  auto* committed = p->sim2gse_committed;
+  auto committed_from = p->sim2gse_committed_origin;
+  p->sim2gse_committed = nullptr;
+  p->sim2gse_waiting_confirmation = false;
+  p->sim2gse_candidates.clear();
+  if (committed && p->sim2gse_tentative_gcd)
+  {
+    p->sim2gse_record("queue_confirm", committed, committed_from);
+    p->sim2gse_tentative_gcd = false;
+    p->sim2gse_confirmed_tentative_gcd = true;
+    p->sim2gse_confirmed_tentative_origin = committed_from;
+    p->sim2gse_confirmed_tentative_action = committed;
+  }
+  if (committed) p->sim2gse_dispatch_action(committed, committed_from);
+}
+
+static void sim2gse_execute_committed(player_t* p)
+{
+  if (!p->sim2gse_committed) return;
+  const auto native_delay = sim2gse_action_delay(p, p->sim2gse_committed, false);
+  const auto execute_delay = native_delay + std::max(0_ms, p->rng().gauss(p->sim->queue_lag));
+  p->sim2gse_queue = make_event(*p->sim, execute_delay + 1_ms, [p] {
+    p->sim2gse_queue = nullptr;
+    if (p->sim2gse_tentative_gcd && p->sim2gse_tentative_stable_reads < 2)
+    {
+      p->sim2gse_waiting_confirmation = true;
+      return;
+    }
+    sim2gse_finish_committed(p);
+  });
+}
+
+static void sim2gse_commit_pending(player_t* p, bool defer_execution = false)
+{
+  auto* next = p->sim2gse_pending;
+  auto from = p->sim2gse_pending_origin;
+  p->sim2gse_pending = nullptr;
+  if (!next) return;
+  if (!sim2gse_queue_requirements(next))
+  {
+    p->sim2gse_record("commit_failed", next, from);
+    p->sim2gse_candidates.clear();
+    return;
+  }
+  p->sim2gse_committed = next;
+  p->sim2gse_committed_origin = from;
+  if (p->sim2gse_observed_gcd_states.empty())
+    p->sim2gse_client_gcd_ready = std::max(p->sim->current_time(), p->gcd_ready) + next->gcd();
+  p->sim2gse_record(p->sim2gse_observed_gcd_states.empty() ? "queue_commit" : "queue_tentative", next, from);
+  if (!defer_execution) sim2gse_execute_committed(p);
+}
+
+// Throwaway task-8 controller. Fixed single-target, instant player actions only.
+// Queue policy is an experiment, not a claim about the WoW client.
+static void sim2gse_arm_queue(player_t* p)
+{
+  event_t::cancel(p->sim2gse_commit);
+  if (!p->sim2gse_pending) return;
+  if (!p->sim2gse_observed_gcd_states.empty()) return;
+  const auto delay = sim2gse_action_delay(p, p->sim2gse_pending, true);
+  const auto commit_lead = p->sim->current_time() < p->sim2gse_precombat_gcd ? 0_ms :
+                           p->sim->queue_gcd_reduction;
+  const auto commit_delay = std::max(0_ms, delay - commit_lead);
+  p->sim2gse_commit = make_event(*p->sim, commit_delay, [p] {
+    p->sim2gse_commit = nullptr;
+    sim2gse_commit_pending(p);
+  });
+}
