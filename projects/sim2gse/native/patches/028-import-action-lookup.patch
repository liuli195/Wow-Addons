+void player_t::create_import_action_probes()
+{
+  sim2gse_import_actions.clear();
+  if ( is_pet() )
+    return;
+
+  std::set<unsigned> requested_spell_ids;
+  for ( const auto& id_text : util::string_split( sim2gse_action_ids, "," ) )
+  {
+    int parsed_id = 0;
+    try
+    {
+      parsed_id = util::to_int( id_text );
+    }
+    catch ( const std::exception& )
+    {
+      continue;
+    }
+    if ( parsed_id > 0 )
+      requested_spell_ids.insert( static_cast<unsigned>( parsed_id ) );
+  }
+
+  auto hex_value = []( char value ) {
+    if ( value >= '0' && value <= '9' ) return value - '0';
+    if ( value >= 'a' && value <= 'f' ) return value - 'a' + 10;
+    if ( value >= 'A' && value <= 'F' ) return value - 'A' + 10;
+    return -1;
+  };
+  for ( const auto& encoded_name : util::string_split( sim2gse_action_names_hex, "," ) )
+  {
+    if ( encoded_name.empty() || encoded_name.size() > 256 || encoded_name.size() % 2 != 0 )
+      continue;
+    std::string name;
+    bool valid = true;
+    for ( size_t i = 0; i < encoded_name.size(); i += 2 )
+    {
+      const int high = hex_value( encoded_name[ i ] );
+      const int low = hex_value( encoded_name[ i + 1 ] );
+      if ( high < 0 || low < 0 )
+      {
+        valid = false;
+        break;
+      }
+      const char decoded = static_cast<char>( ( high << 4 ) | low );
+      if ( decoded == '\0' || static_cast<unsigned char>( decoded ) < 32 ||
+           static_cast<unsigned char>( decoded ) == 127 )
+      {
+        valid = false;
+        break;
+      }
+      name.push_back( decoded );
+    }
+    if ( !valid || name.empty() )
+      continue;
+    const auto* spell = find_spell( name, specialization() );
+    if ( spell->ok() && spell->is_level( true_level ) )
+      requested_spell_ids.insert( spell->id() );
+  }
+
+  for ( const unsigned spell_id : requested_spell_ids )
+  {
+    for ( const auto& action_name : action_names_from_spell_id( spell_id ) )
+    {
+      action_t* action = nullptr;
+      auto existing = range::find_if( action_list, [ this, &action_name ]( const action_t* candidate ) {
+        return candidate->player == this && candidate->name_str == action_name && !candidate->background;
+      } );
+      if ( existing != action_list.end() )
+      {
+        action = *existing;
+      }
+      else
+      {
+        try
+        {
+          action = create_action( action_name, "" );
+        }
+        catch ( const std::exception& )
+        {
+          continue;
+        }
+      }
+      if ( !action || action->player != this || action->background || action->quiet ||
+           !action->data().ok() || !action->data().is_level( true_level ) ||
+           action->data().flags( SX_PASSIVE ) )
+        continue;
+
+      const unsigned native_spell_id = action->data().id();
+      bool selected_talent = false;
+      bool unselected_talent = false;
+      for ( const auto tree : { talent_tree::CLASS, talent_tree::SPECIALIZATION, talent_tree::HERO } )
+      {
+        for ( const unsigned candidate_id : { spell_id, native_spell_id } )
+        {
+          const auto talent = find_talent_spell( tree, candidate_id, specialization() );
+          if ( !talent.invalid() )
+          {
+            selected_talent = selected_talent || talent.enabled();
+            unselected_talent = unselected_talent || !talent.enabled();
+          }
+        }
+      }
+      if ( unselected_talent )
+        continue;
+
+      const auto* action_spell_name = action->data().name_cstr();
+      const bool class_spell = find_class_spell( action_spell_name, specialization() )->id() == native_spell_id;
+      const bool specialization_spell =
+        find_specialization_spell( native_spell_id, specialization() )->id() == native_spell_id;
+      const bool racial_spell = find_racial_spell( action_spell_name )->id() == native_spell_id;
+      if ( !class_spell && !specialization_spell && !racial_spell && !selected_talent )
+        continue;
+
+      const bool duplicate = range::find_if( sim2gse_import_actions,
+        [ spell_id, action ]( const auto& candidate ) {
+          return candidate.first == spell_id && candidate.second == action;
+        } ) != sim2gse_import_actions.end();
+      if ( !duplicate )
+        sim2gse_import_actions.emplace_back( spell_id, action );
+    }
+  }
+}
