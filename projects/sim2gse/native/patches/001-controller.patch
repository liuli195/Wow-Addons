+// Throwaway task-8 controller. Fixed single-target, instant player actions only.
+// Queue policy is an experiment, not a claim about the WoW client.
+static void sim2gse_arm_queue(player_t* p)
+{
+  event_t::cancel(p->sim2gse_queue);
+  if (!p->sim2gse_pending) return;
+  const auto delay = std::max(std::max(0_ms, p->gcd_ready - p->sim->current_time()), p->sim2gse_pending->cooldown->remains());
+  p->sim2gse_queue = make_event(*p->sim, delay, [p] {
+    auto* next = p->sim2gse_pending;
+    auto from = p->sim2gse_pending_origin;
+    p->sim2gse_queue = nullptr;
+    p->sim2gse_pending = nullptr;
+    if (next) p->sim2gse_dispatch_action(next, from);
+  });
+}
+
+void player_t::sim2gse_init()
+{
+  if ( sim2gse_steps.empty() ) return;
+  if ( is_pet() || is_enemy() || specialization() != DEATH_KNIGHT_UNHOLY || sim->threads != 1 )
+    throw std::runtime_error("sim2gse prototype requires one-thread Unholy player");
+  if ( sim2gse_window < 0_ms || sim2gse_window > 400_ms )
+    throw std::runtime_error("sim2gse prototype window must be 0..400ms");
+  auto* list = find_action_priority_list("sim2gse");
+  if ( !list || list->foreground_action_list.empty() )
+    throw std::runtime_error("sim2gse prototype requires actions.sim2gse");
+  if (list->foreground_action_list.size() != list->action_list.size())
+    throw std::runtime_error("sim2gse action removed by native initialization");
+  for ( auto block : util::string_split(sim2gse_steps, "/") )
+  {
+    std::vector<action_t*> actions;
+    unsigned gcd_actions = 0;
+    for ( auto index : util::string_split(block, "+") )
+    {
+      if ( index.empty() || index.find_first_not_of("0123456789") != std::string::npos )
+        throw std::runtime_error("invalid sim2gse action index");
+      auto n = std::stoul(index);
+      if ( n == 0 || n > list->foreground_action_list.size() )
+        throw std::runtime_error("sim2gse action index out of range");
+      auto* a = list->foreground_action_list[n - 1];
+      if ( a->background || !a->option.if_expr_str.empty() || !a->option.target_if_str.empty() ||
+           a->channeled || a->execute_time() != 0_ms ||
+           a->type == ACTION_VARIABLE || a->name_str == "use_items" ||
+           a->name_str == "call_action_list" || a->name_str == "run_action_list" )
+        throw std::runtime_error("unsupported sim2gse prototype action: " + a->name_str);
+      if ( a->gcd() > 0_ms && ++gcd_actions > 1 )
+        throw std::runtime_error("prototype supports at most one GCD action per block");
+      actions.push_back(a);
+    }
+    if ( actions.empty() ) throw std::runtime_error("empty sim2gse block");
+    sim2gse_blocks.push_back(actions);
+  }
+  if ( sim2gse_blocks.empty() || sim2gse_blocks.size() > 128 )
+    throw std::runtime_error("invalid sim2gse sequence length");
+}
+
+void player_t::sim2gse_record(const char* event, action_t* a, unsigned origin)
+{
+  if ( sim2gse_trace )
+    sim->out_log.print("S2GSE\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}", sim->current_time().total_millis(),
+      event, origin, sim2gse_step, a ? a->name_str : "-", gcd_ready.total_millis(),
+      resources.current[RESOURCE_RUNIC_POWER], health_percentage(), a ? a->cooldown->remains().total_millis() : 0);
+}
+
+void player_t::sim2gse_dispatch_action(action_t* a, unsigned origin)
+{
+  if ( resource_regeneration == regen_type::DYNAMIC ) do_dynamic_regen();
+  if ( is_sleeping() || executing || channeling || buffs.stunned->check() || !a->action_ready() ||
+       (a->gcd() > 0_ms && gcd_ready > sim->current_time()) ||
+       !a->cooldown->up() )
+  {
+    sim2gse_record("dispatch_failed", a, origin);
+    return;
+  }
+  sim2gse_record("dispatch", a, origin);
+  if ( a->gcd() == 0_ms )
+    a->queue_execute(execute_type::OFF_GCD);
+  else
+  {
+    sim2gse_dispatch = a;
+    execute_action(); // Keep native foreground scheduling, accounting and stats.
+  }
+}
+
+void player_t::sim2gse_tick()
+{
+  if ( is_sleeping() || sim->event_mgr.canceled ) return;
+  const unsigned origin = ++sim2gse_input;
+  sim2gse_record("input", nullptr, origin);
+  for ( auto* a : sim2gse_blocks[sim2gse_step] )
+  {
+    if ( resource_regeneration == regen_type::DYNAMIC ) do_dynamic_regen();
+    if ( executing || channeling || buffs.stunned->check() )
+    {
+      sim2gse_record("busy", a, origin);
+      continue;
+    }
+    if ( !a->action_ready() )
+    {
+      sim2gse_record("not_ready", a, origin);
+      continue;
+    }
+    const auto delay = a->gcd() > 0_ms ? std::max(std::max(0_ms, gcd_ready - sim->current_time()), a->cooldown->remains()) : 0_ms;
+    if ( delay > sim2gse_window )
+    {
+      sim2gse_record("outside_window", a, origin);
+      continue;
+    }
+    if ( delay > 0_ms )
+    {
+      if ( sim2gse_pending ) sim2gse_record("replace", sim2gse_pending, sim2gse_pending_origin);
+      event_t::cancel(sim2gse_queue);
+      sim2gse_pending = a;
+      sim2gse_pending_origin = origin;
+      sim2gse_record("queue", a, origin);
+      sim2gse_arm_queue(this);
+    }
+    else
+    {
+      if ( a->gcd() > 0_ms )
+      {
+        event_t::cancel(sim2gse_queue);
+        sim2gse_pending = nullptr;
+      }
+      sim2gse_dispatch_action(a, origin);
+    }
+  }
+  sim2gse_step = (sim2gse_step + 1) % sim2gse_blocks.size();
+  make_event(*sim, 300_ms, [this] { sim2gse_tick(); });
+}
