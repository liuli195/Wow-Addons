+static timespan_t sim2gse_tc_wait(player_t* p, action_t* a)
+{
+  const auto now = p->sim->current_time();
+  auto wait = a->gcd() > 0_ms ? p->gcd_ready - now : 0_ms;
+  wait = std::max(wait, p->sim2gse_precombat_cast_ready - now);
+  if (p->executing && p->executing->execute_event)
+    wait = std::max(wait, p->executing->execute_event->remains());
+  return std::max(wait, 0_ms);
+}
+
+static void sim2gse_tc_try_execute(player_t* p)
+{
+  if (!p->sim2gse_pending) return;
+  const auto wait = sim2gse_tc_wait(p, p->sim2gse_pending);
+  if (wait > 0_ms)
+  {
+    event_t::cancel(p->sim2gse_queue);
+    const auto ready_ms = (p->sim->current_time() + wait).total_millis();
+    const auto next_update_ms = ((ready_ms + 9) / 10) * 10; // TC default MapUpdateInterval.
+    p->sim2gse_queue = make_event(*p->sim, timespan_t::from_millis(next_update_ms) -
+      p->sim->current_time(), [p] {
+      p->sim2gse_queue = nullptr;
+      sim2gse_tc_try_execute(p);
+    });
+    return;
+  }
+  auto* action = p->sim2gse_pending;
+  const auto origin = p->sim2gse_pending_origin;
+  p->sim2gse_pending = nullptr;
+  p->sim2gse_record("tc_execute_attempt", action, origin);
+  p->sim2gse_dispatch_action(action, origin);
+}
